            {
              "category": "Support_Service",
              "description": "Customer inquiries, troubleshooting, complaints, or help requests"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Please classify the email provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json."
